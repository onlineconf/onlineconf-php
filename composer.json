{
    "name": "onlineconf/onlineconf",
    "description": "PHP client for OnlineConf: reads configuration from CDB modules generated by onlineconf-updater",
    "type": "library",
    "license": "MIT",
    "keywords": ["onlineconf", "config", "configuration", "cdb"],
    "require": {
        "php": "^8.1",
        "ext-dba": "*",
        "ext-json": "*",
        "psr/log": "^1.1 || ^2 || ^3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.65"
    },
    "autoload": {
        "psr-4": {
            "Onlineconf\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Onlineconf\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/onlineconf-get"],
    "scripts": {
        "test": "phpunit",
        "coverage": [
            "phpunit --coverage-clover=coverage/clover.xml --coverage-text",
            "@coverage-check"
        ],
        "coverage-check": "php tools/coverage-check.php coverage/clover.xml",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "check": ["@cs", "@phpstan", "@coverage"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    }
}
